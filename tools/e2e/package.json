{
  "name": "@green-pavlodar/e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "e2e": "node scripts/run.mjs mock",
    "e2e:api": "node scripts/run.mjs api",
    "e2e:bugs": "node scripts/run.mjs mock --known-bugs",
    "e2e:smoke": "node scripts/run.mjs smoke",
    "e2e:screens": "node scripts/run.mjs screens",
    "e2e:doctor": "node scripts/doctor.mjs",
    "e2e:summary": "node scripts/summary.mjs",
    "e2e:pack": "node scripts/summary.mjs --pack",
    "e2e:gate": "node scripts/summary.mjs --strict",
    "check:tools": "node --test scripts/tests/tooling.test.mjs",
    "check:report": "node --test scripts/tests/report.browser.mjs",
    "report": "playwright show-report playwright-report/mock"
  },
  "devDependencies": { "@playwright/test": "1.64.1", "fflate": "0.8.3" }
}
