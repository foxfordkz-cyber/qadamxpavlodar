# Owner-only configuration: copy to ignored .env.cloud, never commit populated values.
# Production has NO CLOUD_LOCAL_TEST. This file intentionally cannot start unconfigured.
NODE_ENV=production
CLOUD_TRUST_PROXY_HOPS=1
DATABASE_URL=
CLOUD_ALLOWED_HOSTS=
ALLOWED_HOSTS=
FRONTEND_ORIGINS=
# Optional trusted PostgreSQL CA file path. Never disable certificate verification.
PG_CA_FILE=
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=green-pavlodar-photos
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_ALLOWED_HOSTS=
# One-off local bootstrap only; do not put DEMO_PASSWORD in the long-running service.
CLOUD_DEMO_SEED=0
DEMO_PASSWORD=
# Candidate v6 only. Rules require no provider key. External calls are opt-in.
CLOUD_ASSISTANT_ENABLED=1
CLOUD_LLM_ENABLED=0
LLM_TIMEOUT_MS=20000
LLM_ALLOWED_HOSTS=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Optional reserve: configure all three privately, with its exact host above.
LLM2_BASE_URL=
LLM2_MODEL=
LLM2_API_KEY=
