# DEMO only. Скопируйте в .env и поменяйте пароль. .env не коммитится (.gitignore).
# Никаких настоящих ключей, рабочих адресов и персональных данных в этом файле.
NODE_ENV=development
PORT=3100
# Локально — только loopback. В контейнере docker-compose.yml ставит HOST=0.0.0.0.
HOST=127.0.0.1
# База и фото: локально по умолчанию data/ и uploads/ этого проекта, в контейнере — том /data (STORAGE_ROOT).
# Не раскомментируйте строки ниже для Docker: там пути задаёт docker-compose.yml.
# DB_PATH=./data/green-pavlodar-demo.sqlite
# UPLOADS_PATH=./uploads
# Хосты, по которым открывают сайт кроме localhost (например, IP ноутбука в сети жюри), через запятую.
ALLOWED_HOSTS=
# Фронтенд на другом порту (vite dev). Только явные origin на loopback или ALLOWED_HOSTS.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Пароль всех демо-аккаунтов (admin, coordinator, viewer, foreman1, worker1…). Минимум 12 символов.
# Если пусто, seed сгенерирует случайный и напечатает его один раз.
DEMO_PASSWORD=change-me-demo-2026

# Модель ассистента (ТЗ 3.10). Без ключей ассистент отвечает по правилам.
# Другие готовые варианты (DeepSeek, Grok, Ollama) — в папке env-templates/.
# === Модель ассистента: Groq (основная, быстрая) + Gemini (резерв) — рекомендуется, бесплатно ===
# 1. Вставьте ключ(и) сразу после «=» в строках *_API_KEY — без пробелов и кавычек.
# 2. Этот блок целиком замените в apps/server/.env (всё от строки «# === Модель ассистента» до конца файла).
# 3. Проверьте: npm --prefix apps/server run llm:check   4. Перезапустите сервер.
# Модели проверены 29.10.2026 на бесплатных ключах: вызывают функции, время ответа — в комментариях.

# Основная: Groq (через «q», это не Grok) — бесплатно, ответ ассистента ≈1,5 с. Бесплатный лимит — 2–3 вопроса в минуту.
# Ключ: https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# Резерв: Google Gemini — бесплатно, ответ ассистента 4–9 с. gemini-3.8-flash умнее, но 29.10 часто не отвечала или «высокая нагрузка».
# Ключ: https://aistudio.google.com/apikey
LLM2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM2_MODEL=gemini-3.5-flash-lite
LLM2_API_KEY=

# Хосты всех моделей выше — иначе сетевой ограничитель сервера их не пропустит (localhost разрешён всегда).
LLM_ALLOWED_HOSTS=api.groq.com,generativelanguage.googleapis.com

# Общий лимит на ответ, мс: делится между моделями по очереди; если ни одна не успела — ответ по правилам.
LLM_TIMEOUT_MS=20000
