# DEMO only. Скопируйте в .env и поменяйте пароль. .env не коммитится (.gitignore).
# Никаких настоящих ключей, рабочих адресов и персональных данных в этом файле.
NODE_ENV=development
PORT=3100
# Локально — только loopback. В контейнере docker-compose.yml ставит HOST=0.0.0.0.
HOST=127.0.0.1
# Локально база и фото — внутри data/ и uploads/ этого проекта.
DB_PATH=./data/green-pavlodar-demo.sqlite
UPLOADS_PATH=./uploads
# В контейнере вместо двух строк выше: STORAGE_ROOT=/data (volume gp-data).
# Хосты, по которым открывают сайт кроме localhost (например, IP ноутбука в сети жюри), через запятую.
ALLOWED_HOSTS=
# Фронтенд на другом порту (vite dev). Только явные origin на loopback или ALLOWED_HOSTS.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Пароль всех демо-аккаунтов (admin, coordinator, viewer, foreman1, worker1…). Минимум 12 символов.
# Если пусто, seed сгенерирует случайный и напечатает его один раз.
DEMO_PASSWORD=change-me-demo-2026
# --- Модель ассистента (ТЗ 3.10). Любой OpenAI-совместимый API. Без ключа ассистент отвечает по правилам. ---
# Основная — LLM_*, резервная — LLM2_* (при лимите, сбое или долгом ответе основной). Можно задать только одну.
# Имя модели проверьте в консоли провайдера: списки моделей меняются.
# В LLM_ALLOWED_HOSTS — хосты ВСЕХ заданных моделей через запятую, иначе сетевой ограничитель их не пропустит.
#
# Варианты (адрес | пример модели | где взять ключ):
#   Google Gemini — бесплатно с лимитами: https://generativelanguage.googleapis.com/v1beta/openai | gemini-2.5-flash | aistudio.google.com
#   Groq (не Grok) — бесплатно с лимитами, очень быстро: https://api.groq.com/openai/v1 | llama-3.3-70b-versatile | console.groq.com
#   DeepSeek — платно, дёшево: https://api.deepseek.com | deepseek-chat | platform.deepseek.com
#   Grok (xAI) — платно: https://api.x.ai/v1 | имя из консоли | console.x.ai
#   Ollama — локально, без ключа (любой текст в API_KEY): http://ollama:11434/v1 | qwen2.5:7b

# Основная модель (пример — Gemini):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=
LLM_API_KEY=

# Резервная модель (пример — Groq):
LLM2_BASE_URL=https://api.groq.com/openai/v1
LLM2_MODEL=
LLM2_API_KEY=

LLM_ALLOWED_HOSTS=generativelanguage.googleapis.com,api.groq.com
# Общий лимит на ответ, мс: делится между основной и резервной; если обе не успели — ответ по правилам.
LLM_TIMEOUT_MS=20000
