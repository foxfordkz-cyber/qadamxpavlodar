{
  "name": "green-pavlodar-backend-preparation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local DEMO preparation; API and schema are provisional",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import ./scripts/local-network-guard.mjs --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env --import ./scripts/local-network-guard.mjs --import tsx src/server.ts",
    "seed": "node --env-file-if-exists=.env --import tsx src/seed-cli.ts",
    "test": "node --import ./scripts/local-network-guard.mjs --import ./tests/setup-env.mjs --import tsx --test --test-concurrency=2 tests/*.test.ts",
    "smoke": "node --import ./scripts/local-network-guard.mjs scripts/smoke.mjs",
    "demo:integration": "pwsh -NoProfile -File scripts/demo-integration.ps1",
    "seed:v2": "node --env-file-if-exists=.env --import ./scripts/local-network-guard.mjs --import tsx src/v2-seed-cli.ts",
    "test:v2": "node --import ./scripts/local-network-guard.mjs --import ./tests/setup-env.mjs --import tsx --test tests/v2.test.ts",
    "demo:v2": "node --env-file-if-exists=.env --import ./scripts/local-network-guard.mjs scripts/demo-v2.mjs",
    "test:municipal": "node --import ./scripts/local-network-guard.mjs --import ./tests/setup-env.mjs --import tsx --test tests/municipal.test.ts",
    "demo:municipal": "node --import ./scripts/local-network-guard.mjs --import tsx scripts/demo-municipal.mjs",
    "seed:tz": "node --env-file-if-exists=.env --import ./scripts/local-network-guard.mjs --import tsx src/tz/seed-cli.ts",
    "seed:outcomes": "node --env-file-if-exists=.env --import ./scripts/local-network-guard.mjs --import tsx src/outcomes/seed-cli.ts",
    "llm:check": "node --env-file-if-exists=.env --import ./scripts/local-network-guard.mjs --import tsx src/tz/llm-check-cli.ts",
    "perf": "node --import ./scripts/local-network-guard.mjs scripts/perf.mjs",
    "start:cloud": "node --env-file-if-exists=.env.cloud --import ./scripts/local-network-guard.mjs --import tsx dist/cloud/server.js",
    "seed:cloud": "node --env-file-if-exists=.env.cloud --import ./scripts/local-network-guard.mjs --import tsx dist/cloud/seed-cli.js",
    "storage:reconcile": "node --env-file-if-exists=.env.cloud --import ./scripts/local-network-guard.mjs --import tsx dist/cloud/photo-reconcile-cli.js",
    "test:postgres": "node --import ./scripts/local-network-guard.mjs --import tsx --test --test-concurrency=1 tests/postgres/*.test.ts",
    "openapi:cloud": "node --import ./scripts/local-network-guard.mjs --import tsx scripts/generate-cloud-openapi.mjs"
  },
  "dependencies": {
    "@turf/turf": "^7.4.0",
    "csv-parse": "7.0.3",
    "exceljs": "^4.4.0",
    "express": "5.3.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "multer": "2.5.0",
    "pdfkit": "^0.20.2",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "shpjs": "^6.2.0",
    "swagger-ui-dist": "5.34.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "embedded-postgres": "18.6.0-beta.19",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
