# Copy to .env.cloud (Git-ignored). Set actual values securely; never commit credentials.
# Local PostgreSQL test settings only. Production must OMIT CLOUD_LOCAL_TEST and use TLS.
CLOUD_LOCAL_TEST=1
DATABASE_URL=
PORT=3001
ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_ORIGINS=http://localhost:5173
CLOUD_ALLOWED_HOSTS=
CLOUD_TRUST_PROXY_HOPS=0
# Optional trusted Supabase CA PEM file, mounted as a server secret file in production.
PG_CA_FILE=
# Explicit one-off seed only; never overwrite an existing account.
CLOUD_DEMO_SEED=0
DEMO_PASSWORD=
# Reserved for the private Storage adapter; upload API is NOT migrated in this slice.
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=
SUPABASE_SERVICE_ROLE_KEY=
