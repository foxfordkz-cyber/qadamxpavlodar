# === Модель ассистента: Grok (основная, платно) + Groq (резерв) ===
# 1. Вставьте ключ(и) сразу после «=» в строках *_API_KEY — без пробелов и кавычек.
# 2. Этот блок целиком замените в apps/server/.env (всё от строки «# === Модель ассистента» до конца файла).
# 3. Проверьте: npm --prefix apps/server run llm:check   4. Перезапустите сервер.
# Модели проверены 29.10.2026 на бесплатных ключах: вызывают функции, время ответа — в комментариях.

# Основная: Grok (xAI) — платно. Ключ: https://console.x.ai
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.20-0309-non-reasoning
LLM_API_KEY=

# Резерв: Groq (через «q», это не Grok) — бесплатно, ответ ассистента ≈1,5 с. Бесплатный лимит — 2–3 вопроса в минуту.
# Ключ: https://console.groq.com/keys
LLM2_BASE_URL=https://api.groq.com/openai/v1
LLM2_MODEL=openai/gpt-oss-120b
LLM2_API_KEY=

# Хосты всех моделей выше — иначе сетевой ограничитель сервера их не пропустит (localhost разрешён всегда).
LLM_ALLOWED_HOSTS=api.x.ai,api.groq.com

# Общий лимит на ответ, мс: делится между моделями по очереди; если ни одна не успела — ответ по правилам.
LLM_TIMEOUT_MS=20000
