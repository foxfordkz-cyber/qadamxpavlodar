# === Модель ассистента: DeepSeek (основная, платно и дёшево) + Groq (резерв, бесплатно) ===
# 1. Вставьте ключ(и) сразу после «=» в строках *_API_KEY — без пробелов и кавычек.
# 2. Этот блок целиком замените в apps/server/.env (всё от строки «# === Модель ассистента» до конца файла).
# 3. Проверьте: npm --prefix apps/server run llm:check   4. Перезапустите сервер.
# Имена моделей сверены с документацией провайдеров 29.10.2026; если модель сменилась — llm:check покажет доступные.

# Основная: DeepSeek — платно, но дёшево (пополните баланс). Ключ: https://platform.deepseek.com/api_keys
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# Резерв: Groq (через «q», это не Grok) — бесплатно, очень быстро. Ключ: https://console.groq.com/keys
# Если резерв не нужен — оставьте LLM2_API_KEY пустым.
LLM2_BASE_URL=https://api.groq.com/openai/v1
LLM2_MODEL=llama-3.3-70b-versatile
LLM2_API_KEY=

# Хосты всех моделей выше — иначе сетевой ограничитель сервера их не пропустит.
LLM_ALLOWED_HOSTS=api.deepseek.com,api.groq.com

# Общий лимит на ответ, мс: делится между основной и резервной; если обе не успели — ответ по правилам.
LLM_TIMEOUT_MS=20000
